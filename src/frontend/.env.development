# true  = el front usa datos de prueba (no necesita backend ni Keycloak)
# false = el front llama al backend real
# Para probar contra el backend real SIN tocar este archivo, crear
# .env.development.local (Git lo ignora) con: VITE_USE_MOCK=false
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=meru-app
VITE_KEYCLOAK_CLIENT_ID=meru-frontend